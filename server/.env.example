# Copy to .env (git-ignored) and fill in. The server reads real environment
# variables only; load this file with `set -a; . ./.env; set +a` or with
# systemd EnvironmentFile=. No secrets belong in this example.
ENV=prod
LISTEN=127.0.0.1:8787
DB_PATH=/var/lib/ngajio/ngajio.db
#BACKUP_DIR=/var/lib/ngajio/backup
GOOGLE_CLIENT_ID=
#ALLOWED_ORIGINS=http://localhost:5173
#TRUST_PROXY_HEADER=X-Real-IP

# Dev only. DEV_LOGIN=1 and COOKIE_SECURE=false are refused unless ENV=dev
# (DEV_LOGIN also needs a loopback LISTEN host).
#DEV_LOGIN=1
#COOKIE_SECURE=false
