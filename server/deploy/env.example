# Installed to /etc/ngajio/env (root:root, mode 600). No secrets belong in the repo.
ENV=prod
LISTEN=127.0.0.1:8787
DB_PATH=/var/lib/ngajio/ngajio.db
BACKUP_DIR=/var/lib/ngajio/backup
# The owner pastes the Google OAuth Client ID here (Web application type).
# No client secret is needed.
GOOGLE_CLIENT_ID=
COOKIE_SECURE=true
TRUST_PROXY_HEADER=X-Real-IP
# DEV_LOGIN must NEVER be set in production. (The server refuses to start with it
# unless ENV=dev anyway.)
